{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tempoapi",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "secrets": {
    "required": [
      "STRAVA_CLIENT_ID",
      "STRAVA_CLIENT_SECRET",
      "MODERATION_TOKEN",
      "AUTH_PEPPER"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TOKEN_STORE",
      "id": "932a2f4aa3ec4f3fac45f3497344571f"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth/*",
      "/mobile/auth/*",
      "/api/*",
      "/webhooks/*",
      "/privacy",
      "/terms",
      "/reset-password"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_INBOX",
        "class_name": "NotificationInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "notification-inbox-v1",
      "new_sqlite_classes": [
        "NotificationInbox"
      ]
    }
  ]
}
